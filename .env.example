# Values read from environment, not loaded from this file automatically.
# Demo is always available. Leave provider options unset until configured.
NEXUS_DB=./nexus.sqlite3
# Point this at the local inference SERVICE, not an Intel GPU driver itself.
ARC_CHAT_URL=http://127.0.0.1:8080/v1/chat/completions
ARC_MODEL_ID=your-served-model-id
# ARC_API_KEY=optional
# AWS_PROFILE=your-profile
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=your-bedrock-model-or-inference-profile-id
